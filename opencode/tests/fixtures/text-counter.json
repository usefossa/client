{
  "tokenizer": {
    "version": "1.0",
    "truncation": null,
    "padding": null,
    "added_tokens": [],
    "normalizer": null,
    "pre_tokenizer": {
      "type": "WhitespaceSplit"
    },
    "post_processor": null,
    "decoder": null,
    "model": {
      "type": "WordPiece",
      "vocab": {
        "[UNK]": 0,
        "user": 1,
        "system": 2,
        "assistant": 3,
        "hello": 4,
        "world": 5,
        "read_file": 6,
        "é": 7
      },
      "unk_token": "[UNK]",
      "continuing_subword_prefix": "##",
      "max_input_chars_per_word": 100
    }
  },
  "chatTemplate": "{% if tools is defined %}{% for tool in tools %}{{ tool.function.name }} {% endfor %}{% endif %}{% for message in messages %}{{ message.role }} {{ message.content }} {% endfor %}{% if add_generation_prompt %}assistant{% endif %}",
  "checks": [
    {
      "messages": [
        {
          "role": "user",
          "content": "hello world"
        }
      ],
      "tokens": 4
    },
    {
      "messages": [
        {
          "role": "user",
          "content": "é"
        }
      ],
      "tools": [
        {
          "type": "function",
          "function": {
            "name": "read_file"
          }
        }
      ],
      "tokens": 4
    }
  ]
}
