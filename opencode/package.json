    "@opentui/solid": { "optional": true },
    "solid-js": { "optional": true }
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/bun": "1.4.2",
    "typescript": "5.9.3",
    "jsonc-parser": "3.3.1",
    "solid-js": "1.9.17",
    "@opentui/core": "0.6.0",
    "@opentui/solid": "0.6.0",
    "@opencode/plugin": "2.0.26"
  }
}
