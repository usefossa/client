{
  "name": "@fossa/opencode",
  "version": "0.11.7",
  "private": true,
  "engines": {
    "bun": ">=1.3.14"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.tsx",
    "./rpc": "./src/rpc.ts"
  },
  "files": [
    "src/*.ts",
